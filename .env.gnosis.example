# The live Gnosis Chain deployment. Copy to .env.gnosis and run `just dev-gnosis` (vite --mode gnosis).
# All values are public. Pipeline: contracts -> indexer -> frontend.
VITE_CHAINS=gnosis
VITE_DELIBERATE_ADDRESS_GNOSIS=0xCA2449a3849B2a6dDc673613F24760ff366d6b09
VITE_CIRCLES_REGISTRY_GNOSIS=0xF91B944D63351FFA2Af89f49D0D03717Dd6608C7
# Optional; unset, the chain's public endpoint from viem's registry is used.
VITE_RPC_URL_GNOSIS=https://rpc.gnosischain.com
# The indexer's GraphQL endpoint (envio.dev). One indexer covers every chain the contract is on and
# a query names the chain it wants, so this is not per-network. A local dev server has no query proxy
# in front of it, so this points straight at the endpoint; the hosted site reaches the same endpoint
# through /api/graphql and its server-side INDEXER_UPSTREAM_URL.
VITE_INDEXER_URL=https://indexer.dev.hyperindex.xyz/<id>/v1/graphql

# Hosted (Vercel): set the VITE_* values above as project env vars (baked into the public bundle at
# build time) without VITE_INDEXER_URL, so indexer reads go through the same-origin proxy; the
# indexer endpoint (INDEXER_UPSTREAM_URL) is a server-side Vercel env var - never VITE_-prefixed
# and never in an env file. Per-network variables never inherit unsuffixed ones: a network with no
# address of its own must fail rather than quietly read another network's contract. See README.md.
