# The live Gnosis Chain deployment. Copy to .env.gnosis and run `just dev-gnosis` (vite --mode gnosis).
# All values are public. Pipeline: contracts -> indexer -> frontend.
VITE_CHAINS=gnosis
VITE_DELIBERATE_ADDRESS_GNOSIS=0x260879778DE7A983565219c2C64f3b4cB927259a
VITE_CIRCLES_REGISTRY_GNOSIS=0xF7421e860a9559a609963AbC4900394134e7AaCf
# Optional; unset, the chain's public endpoint from viem's registry is used.
VITE_RPC_URL_GNOSIS=https://rpc.gnosischain.com
# The hosted indexer's GraphQL endpoint (envio.dev). A local dev server has no query proxy in front
# of it, so this points straight at the endpoint; the hosted site reaches the same endpoint through
# /api/graphql/gnosis and its server-side INDEXER_UPSTREAM_URL_GNOSIS.
VITE_INDEXER_URL_GNOSIS=https://indexer.dev.hyperindex.xyz/123abc/v1/graphql
# Reads are digest-verified, so an untrusted gateway is fine. Vite does not run the api/ functions,
# so a local dev server reads and pins through the hosted site's proxies - which reflect loopback
# origins for exactly this. Writes and reads must target the same pinning home: a mismatch (e.g.
# local-kubo writes + hosted reads) strands content as digests for others.
VITE_IPFS_GATEWAY=https://www.deliberate.garden/api
VITE_IPFS_API=https://www.deliberate.garden
# Offline/throwaway alternative - the dockerized kubo (just ipfs-up) for both:
#   VITE_IPFS_GATEWAY=http://127.0.0.1:8080
#   VITE_IPFS_API=http://127.0.0.1:5001

# Hosted (Vercel): set the VITE_* values above as project env vars (baked into the public bundle at
# build time) with VITE_IPFS_API=/ and no VITE_INDEXER_URL_GNOSIS, so authoring and indexer reads go
# through the same-origin proxies; their credentials (FILEBASE_*) and the indexer endpoint
# (INDEXER_UPSTREAM_URL_GNOSIS) are server-side Vercel env vars - never VITE_-prefixed and never in
# an env file. Per-network variables never inherit unsuffixed ones: a network with no address of its
# own must fail rather than quietly read another network's contract. See README.md.
