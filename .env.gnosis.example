# The live Gnosis Chain deployment. Copy to .env.gnosis and run `just dev-gnosis` (vite --mode gnosis).
# All values are public. Pipeline: contracts -> indexer -> frontend.
VITE_CHAINS=gnosis
VITE_DELIBERATE_ADDRESS_GNOSIS=0xCA2449a3849B2a6dDc673613F24760ff366d6b09
VITE_CIRCLES_REGISTRY_GNOSIS=0xF91B944D63351FFA2Af89f49D0D03717Dd6608C7
# The block Deliberate was deployed in (contracts/broadcast/DeployDeliberate.s.sol/100/run-latest.json):
# argument texts live in the contract's events, and a chain read of them scans the log from here.
VITE_DEPLOYMENT_BLOCK_GNOSIS=48046147
# Optional; unset, the chain's public endpoint from viem's registry is used.
VITE_RPC_URL_GNOSIS=https://rpc.gnosischain.com
# The hosted indexer's GraphQL endpoint (envio.dev). A local dev server has no query proxy in front
# of it, so this points straight at the endpoint; the hosted site reaches the same endpoint through
# /api/graphql/gnosis and its server-side INDEXER_UPSTREAM_URL_GNOSIS.
VITE_INDEXER_URL_GNOSIS=https://indexer.dev.hyperindex.xyz/ca38628/v1/graphql

# Hosted (Vercel): set the VITE_* values above as project env vars (baked into the public bundle at
# build time) without VITE_INDEXER_URL_GNOSIS, so indexer reads go through the same-origin proxy; the
# indexer endpoint (INDEXER_UPSTREAM_URL_GNOSIS) is a server-side Vercel env var - never VITE_-prefixed
# and never in an env file. Per-network variables never inherit unsuffixed ones: a network with no
# address of its own must fail rather than quietly read another network's contract. See README.md.
